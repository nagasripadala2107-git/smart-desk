# ==============================================================================
# SmartDesk Local Development Environment Configuration Template
# ==============================================================================
# For Docker Compose deployments, see .env.docker.example
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT:
#   - NEVER commit real credentials, passwords, or secrets to version control.
#   - .env is git-ignored by default.
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=smartdesk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Security: JWT Signing Secret (HMAC-SHA256, minimum 256-bit / 32-byte secret)
JWT_SECRET=replace-with-a-long-random-secret

# Backend Database Connection (Localhost)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartdesk
DB_USERNAME=postgres
DB_PASSWORD=change-me

# AI Microservice URL (Localhost)
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=3000

# Backend Server & CORS Configuration
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend Browser API URL
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
