# SmartDesk Environment Configuration Template
# Copy this file to .env or set environment variables in your deployment environment.
# DO NOT COMMIT REAL PASSWORDS OR SECRETS TO VERSION CONTROL.

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartdesk
DB_USERNAME=smartdesk
DB_PASSWORD=your_secure_password_here

# Server Configuration
SERVER_PORT=8080

# Security / JWT Configuration (Minimum 256-bit secret for HMAC-SHA256)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=86400000

# Logging
LOG_LEVEL=INFO

# AI Ticket Classification Microservice (Phase 5)
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=2000
