# ==============================================================================
# SmartDesk Production Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.prod:
#    cp .env.prod.example .env.prod
# 2. Populate all placeholder values with verified production secrets.
# 3. Restrict file permissions immediately:
#    chmod 600 .env.prod
#
# IMPORTANT SECURITY & OPERATIONAL RULES:
# - NEVER commit real credentials, passwords, or secrets to version control.
# - .env* files are git-ignored by default.
# - DO NOT use default or sample passwords in any live or staging environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Production Domain & Networking
# ------------------------------------------------------------------------------
# Fully qualified domain name used by Nginx for TLS certificate and routing
DOMAIN_NAME=smartdesk.example.com

# Frontend public API URL for browser clients.
# In production behind the unified Nginx reverse proxy, this MUST be the relative path /api/v1.
# Do NOT configure localhost:8080 in production.
NEXT_PUBLIC_API_URL=/api/v1

# ------------------------------------------------------------------------------
# 2. PostgreSQL Production Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=smartdesk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD_MIN_24_CHARS

# IMPORTANT NOTE ON POSTGRESQL PASSWORD BEHAVIOR:
# POSTGRES_PASSWORD is evaluated by the official postgres container ONLY during initial
# cluster creation (when /var/lib/postgresql/data is empty). Changing POSTGRES_PASSWORD
# in an existing persistent cluster does NOT rotate the internal PostgreSQL user password.
# To rotate an existing database password, execute:
#   ALTER USER postgres WITH PASSWORD 'new-password';
# as a separate, explicitly authorized operation.

# Backend Internal Connection Settings (via internal Docker DNS)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=smartdesk
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD_MIN_24_CHARS

# Connection Pool Tuning (HikariCP)
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# ------------------------------------------------------------------------------
# 3. Security & Token Settings
# ------------------------------------------------------------------------------
# Cryptographically secure HMAC-SHA256 signing secret.
# MANDATORY REQUIREMENT: Must be at least 256 bits (32 bytes / 64 hexadecimal characters).
# Generate using: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATED_CRYPTOGRAPHIC_SECRET_MIN_64_HEX_CHARS

# JWT Token validity in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# Authentication endpoint rate limit (requests per minute per IP)
RATE_LIMIT_AUTH_PER_MINUTE=30

# CORS Allowed Origins (comma-separated, or empty when using Nginx unified origin)
CORS_ALLOWED_ORIGINS=https://smartdesk.example.com

# ------------------------------------------------------------------------------
# 4. Internal AI Microservice Configuration
# ------------------------------------------------------------------------------
# Internal Docker network DNS URL (browser NEVER communicates directly with AI)
AI_SERVICE_URL=http://ai-service:8000
AI_TIMEOUT_MS=3000

# AI Worker concurrency (conservative setting: 2 workers for 1GB container RAM)
AI_WORKERS=2

# Duplicate detection algorithm parameters
AI_DUPLICATE_THRESHOLD=0.70
AI_DUPLICATE_MAX_MATCHES=5
AI_DUPLICATE_MAX_CANDIDATES=50

# ------------------------------------------------------------------------------
# 5. Database Automated Backup Settings
# ------------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=14
BACKUP_CRON_SCHEDULE=0 2 * * *
BACKUP_ON_STARTUP=false
